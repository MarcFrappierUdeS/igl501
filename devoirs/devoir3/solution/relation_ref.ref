REFINEMENT relation_ref(k)
REFINES relation
VARIABLES f
INVARIANT
  f : ((0..k) * (0..k)) --> BOOL
& dom(f|>{TRUE}) = r

INITIALISATION
    f := ((0..k) * (0..k)) * {FALSE}
		
OPERATIONS

ajouter(x, y) =
  PRE
    x : 0..k & y : 0..k
  THEN
    f(x|->y):= TRUE
  END;


produit =
  BEGIN
    f :=
      {x,y,v |
          x : 0..k
        & y : 0..k
        & v = bool
            (
            #z.
              (
                z : 0..k
              & f(x|->z)=TRUE
              & f(z|->y)=TRUE
              )
            )
      }
  END;


res <-- appartient(x, y) =
  PRE
    x : 0..k & y : 0..k
  THEN
    res := FALSE//f(x|->y)
  END

END

