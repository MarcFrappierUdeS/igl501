REFINEMENT file_ref(k)
REFINES file
VARIABLES v, d, n
INVARIANT
  v : 0..(k-1) --> 0..k
& d : 0..(k-1)
& n : 0..k
& n = size(f)
& !(x).
    (
      x : dom(f)
    =>
      f(x) = v((d + x - 1) mod k)
    )

INITIALISATION
   v := (0..(k-1)) * {0}
|| n := 0
|| d := 0 
		
OPERATIONS

enfiler(x) =
  PRE x : 0..k & n < k
  THEN n := n+1 || v((d+n) mod k) := x
  END
;
defiler =
  PRE n > 0
  THEN d := (d+1) mod k || n := n-1
  END
;
res <-- tete =
  PRE n > 0
  THEN res := v(d)
  END

END

