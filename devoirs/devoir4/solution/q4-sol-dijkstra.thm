<?xml version="1.0"?>
<alloy>

<view nodetheme="Martha">

<projection> <type name="State"/> </projection>

<defaultnode/>

<defaultedge/>

<node>
   <type name="acquerir"/>
   <type name="init"/>
   <type name="Int"/>
   <type name="liberer"/>
   <type name="State"/>
   <type name="String"/>
   <type name="stutter"/>
   <type name="univ"/>
   <type name="seq/Int"/>
</node>

<node shape="Ellipse" color="Yellow">
   <type name="P"/>
</node>

<node shape="Parallelogram" color="Green">
   <type name="R"/>
</node>

<node style="Bold">
   <set name="First" type="st/Ord"/>
   <set name="Next" type="st/Ord"/>
</node>

<node style="Bold" label="p">
   <set name="$Transition_p" type="P"/>
</node>

<node style="Bold" label="r">
   <set name="$Transition_r" type="R"/>
</node>

<node visible="no">
   <type name="Event"/>
   <type name="ordering/Ord"/>
   <type name="rs/Ord"/>
   <type name="st/Ord"/>
</node>

<node visible="yes" style="Bold">
   <set name="event" type="Event"/>
</node>

<edge color="Gray" constraint="no">
   <relation name="Next"> <type name="ordering/Ord"/> <type name="Event"/> <type name="Event"/> </relation>
   <relation name="Next"> <type name="rs/Ord"/> <type name="R"/> <type name="R"/> </relation>
</edge>

<edge color="Gray" visible="no" attribute="yes" constraint="no">
   <relation name="First"> <type name="ordering/Ord"/> <type name="Event"/> </relation>
</edge>

</view>

</alloy>
